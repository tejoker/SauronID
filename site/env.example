# Copy to .env.local (never commit that file).
#
# Early-access form backend (optional — without these the form falls back
# to the mailto flow). Values are public by design: the anon key is meant
# for browsers and the table is protected by insert-only RLS
# (see supabase/early_access.sql).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Real Launcher download, enabled the day the binary exists. When set, a
# successful signup immediately starts this download.
# NEXT_PUBLIC_LAUNCHER_URL=https://downloads.sauronid.com/SauronID-Launcher.dmg
