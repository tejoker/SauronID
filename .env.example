# SauronID environment configuration.
# Copy to `.env` and fill in your operator-managed values.
#
# Default mode (development): only ENV=development + SAURON_ADMIN_KEY needed.
# Production: every section below is relevant — read docs/operations.md.

# ───────────────────────────────────────────────────────────
# 1. Core secrets — generate with `openssl rand -hex 32`
# ───────────────────────────────────────────────────────────
# Production checklist
# ENV=production
# SAURON_ADMIN_KEY=replace-with-32-byte-random
# SAURON_ADMIN_JWT_HS256_SECRET=replace-with-32-byte-random  # dashboard mints tenant-locked admin JWTs
# SAURON_TOKEN_SECRET=replace-with-32-byte-random
# SAURON_JWT_SECRET=replace-with-32-byte-random
# SAURON_OPRF_SEED=replace-with-32-byte-random
# SAURON_ALLOWED_ORIGINS=https://app.example.com,https://api.example.com
# SAURON_REQUIRE_CALL_SIG=1                  # fail-closed on missing per-call sigs
# SAURON_REQUIRE_AGENT_TYPE=1                # reject legacy operator-supplied checksum
# SAURON_ALLOW_CUSTOM_CHECKSUM=0             # gap #3: refuse agent_type=custom in prod (no required-field contract)
# SAURON_CHECKSUM_INPUTS_STORAGE=hash_only   # privacy: store only the digest, never the raw system_prompt/tools (default: plaintext)
# --- gap #4: attestation enforced at /agent/register ---
# SAURON_AUDIT_HMAC_KEY=replace-with-32-byte-random  # H-2: keys the tamper-evident security-audit hash chain; REQUIRED in prod (dev uses a fixed fallback)
# SAURON_NITRO_REQUIRE_ROOT / SAURON_NITRO_REJECT_DEV_MODE default to fail-closed in production (set =0 to opt out)
# SAURON_REQUIRE_HARDWARE_ATTESTATION=1      # reject none/server_derived; require a verifiable hardware attestation kind
# SAURON_REQUIRE_PREREGISTERED_MEASUREMENT=1 # mode (a): asserted measurement must be in the golden allowlist (else TOFU)
# SAURON_ATTESTATION_GOLDEN_MEASUREMENTS=    # comma-separated hex golden measurements (required when the flag above is set)
# --- anonymous ring-policy redesign (docs/design/anonymous-ring-policy.md) ---
# SAURON_ADMIN_CROSS_TENANT=1                # admin queries see ALL tenants (single trusted super-admin only). OFF by default = admin scoped to the request's tenant. Leave OFF for multi-customer.
# SAURON_ADMIN_JWT_HS256_SECRET=...          # enable admin-JWT auth so the tenant is bound to the token (header can't override it). Required for safe multi-tenant.
# SAURON_EGRESS_GATEWAY=1                    # enable in-path enforced egress: POST /agent/egress/proxy (host+method+path allowlist from intent_json.egress_allowlist)
# SAURON_EGRESS_REDACT_PII=1                 # phase 2: regex-redact PII (email/ssn/iban/card/phone) from forwarded egress bodies (opt-in; coarse)
# SAURON_ANON_RINGS=1                        # phase 2-4: enable /admin/rings* + /agent/action/anon + /agent/usage
# SAURON_RING_TRAPDOOR_SECRET=<32-byte hex>  # operator trapdoor t (derives per-ring pseudonyms); REQUIRED in prod when anon rings on
# SAURON_MODEL_PRICES={"claude-opus-4-8":{"in_per_1k":0.015,"out_per_1k":0.075}}  # phase 4: per-model USD/1k tokens; unknown/local models → usd 0, tokens still tracked

# Development defaults — used by quickstart.sh
ENV=development
# REQUIRED — generate with openssl rand -hex 32
SAURON_ADMIN_KEY=replace-with-32-byte-random
DATABASE_PATH=./sauron.db
# Least-privilege admin (custody):
#  - SAURON_ADMIN_READ_ONLY_KEYS: comma-separated keys that may only GET/HEAD
#    (monitoring, dashboards) — mutations return 403. Use these for anything
#    that does not need to mutate; keep the full-write key server-side only.
#  - Admin JWTs (Bearer, HS256) carry scopes `scp` (admin:read|write|super) and
#    an optional tenant allowlist `tnt`: a non-super JWT with `tnt:["acme"]` may
#    act ONLY on tenant acme, regardless of SAURON_ADMIN_CROSS_TENANT. This is
#    the per-operator least-privilege path (vs the god-mode static key).
#  - Secret custody: SAURON_ADMIN_KEY_WRAPPED / *_KEYS entries may be Vault
#    Transit ciphertext (decrypted at boot) so the plaintext never sits in env.
# SAURON_ADMIN_READ_ONLY_KEYS=key1,key2
# SAURON_ADMIN_CROSS_TENANT=1   # global god-mode across tenants for static keys

# ───────────────────────────────────────────────────────────
# 2. Network
# ───────────────────────────────────────────────────────────
# PORT=3001
# SAURON_CORE_URL=https://sauronid.example.com

# ───────────────────────────────────────────────────────────
# 3. Feature flags — turn off legacy surface for pure agent-binding deployments
# ───────────────────────────────────────────────────────────
# SAURON_DISABLE_BANK_KYC=1
# SAURON_DISABLE_USER_KYC=1
# SAURON_DISABLE_ZKP=1
# SAURON_DISABLE_COMPLIANCE=1

# ───────────────────────────────────────────────────────────
# 4. On-chain anchoring (Bitcoin OpenTimestamps + Solana Memo)
# ───────────────────────────────────────────────────────────
SAURON_BITCOIN_ANCHOR_PROVIDER=mock
# Production: SAURON_BITCOIN_ANCHOR_PROVIDER=opentimestamps
# SAURON_OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org
SAURON_BITCOIN_NETWORK=regtest-mock

# Solana — devnet free, mainnet requires funded keypair
# SAURON_SOLANA_ENABLED=1
# SAURON_SOLANA_RPC_URL=https://api.devnet.solana.com
# SAURON_SOLANA_NETWORK=devnet
# SAURON_SOLANA_KEYPAIR_PATH=/etc/sauronid/solana-keypair.json
# SAURON_SOLANA_MEMO_PREFIX=sauronid:v1:

# Anchor batch interval (default 600s)
# SAURON_ACTION_ANCHOR_INTERVAL_SECS=600

# ───────────────────────────────────────────────────────────
# 5. Database backend
# ───────────────────────────────────────────────────────────
# SAURON_DB_BACKEND=sqlite                          # sqlite (default) | postgres
# DATABASE_URL=postgres://sauronid:dev@localhost:5432/sauronid
# SAURON_PG_POOL_SIZE=16
# SAURON_ACCEPT_SINGLE_NODE_SQLITE=1                # acknowledge single-node SQLite in production

# ───────────────────────────────────────────────────────────
# 6. Secret backends — protect root secrets at rest
# ───────────────────────────────────────────────────────────
# SAURON_VAULT_TRANSIT_ENABLED=1
# SAURON_VAULT_ADDR=https://vault.example.com:8200
# SAURON_VAULT_TOKEN=hvs....
# SAURON_VAULT_TRANSIT_KEY=sauronid-root
# SAURON_TOKEN_SECRET_WRAPPED=vault:v1:...
# SAURON_JWT_SECRET_WRAPPED=vault:v1:...
# SAURON_OPRF_SEED_WRAPPED=vault:v1:...
# SAURON_ADMIN_KEY_WRAPPED=vault:v1:...

# AWS KMS path (alternative to Vault)
# SAURON_AWS_KMS_ENABLED=1
# SAURON_AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
# AWS_REGION=us-east-1

# ───────────────────────────────────────────────────────────
# 7. ZKP issuer service — optional add-on
# ───────────────────────────────────────────────────────────
SAURON_ISSUER_URL=http://localhost:4000
ISSUER_SEED=change-me-to-a-long-random-issuer-seed
ISSUER_DID=did:sauron:issuer:1

# ───────────────────────────────────────────────────────────
# 8. Telemetry
# ───────────────────────────────────────────────────────────
# RUST_LOG=info,sauron_core=debug
# SAURON_LOG_FORMAT=json                            # pretty (default) | json

# ───────────────────────────────────────────────────────────
# 9. Rate limits — sliding-window counters per agent / per human
# ───────────────────────────────────────────────────────────
# SAURON_RISK_WINDOW_SECS=60
# SAURON_RISK_AGENT_REGISTER_PER_WINDOW=60
#   Default: 60/window in dev, 20/window in production. Set explicitly to
#   override (e.g. 200 for high-volume issuers, or 0 to disable — operators
#   only). Window unit is SAURON_RISK_WINDOW_SECS (60s default).
# SAURON_RISK_AGENT_VERIFY_PER_WINDOW=300
# SAURON_RISK_KYC_RETRIEVE_PER_WINDOW=120
# SAURON_RISK_AGENT_KYC_CONSENT_PER_WINDOW=60
# SAURON_RISK_PAYMENT_AUTHORIZE_PER_WINDOW=30

# Per-call sig skew window
# SAURON_CALL_SIG_SKEW_MS=60000

# ───────────────────────────────────────────────────────────
# 10. Background GC
# ───────────────────────────────────────────────────────────
# SAURON_GC_INTERVAL_SECS=300
# SAURON_GC_REQUESTS_LOG_RETENTION_DAYS=90

# ───────────────────────────────────────────────────────────
# 11. Forward proxy (egress enforcement)
# ───────────────────────────────────────────────────────────
# SAURON_EGRESS_PROXY_ENABLED=1
# SAURON_EGRESS_PROXY_PORT=3010
# In-path egress gateway (POST /agent/egress/proxy). Response body cap:
# SAURON_EGRESS_GATEWAY=1
# SAURON_EGRESS_MAX_RESP_BYTES=1048576   # default 1 MiB
# Credential broker (docs/design/credential-broker.md): server-held credentials
# injected into outbound requests so the agent never holds the secret. Reference
# by name from an allowlist entry's `inject_credential`. Put the secret in a
# dedicated env var / Vault-injected var (value_env), NOT inline.
# SAURON_EGRESS_CREDENTIALS={"stripe":{"header":"authorization","value_env":"STRIPE_RESTRICTED_KEY"}}
# STRIPE_RESTRICTED_KEY=Bearer sk_live_restricted_...

# ───────────────────────────────────────────────────────────
# 11b. Policy enforcement + blast-radius ceiling
# ───────────────────────────────────────────────────────────
# Enforcement mode: enforce | advisory | off. Prod defaults to `enforce`;
# `off` refuses to boot in prod without SAURON_UNSAFE_ALLOW_ADVISORY_IN_PROD=1.
# SAURON_POLICY_ENFORCEMENT_MODE=enforce
# Require every protected agent to carry a valid, loadable bound policy; agents
# with no binding are DENIED in enforce mode (commercial default).
# SAURON_POLICY_REQUIRE_BINDING=1
# Hard per-action USD ceiling — a circuit-breaker no policy or mode can exceed.
# A broad/misconfigured policy therefore cannot authorize a larger payment.
# SAURON_MAX_ACTION_USD=1000
# Audit hash-chain HMAC key (REQUIRED in production — prod refuses to boot
# without it; the chain would otherwise use a public dev key).
# SAURON_AUDIT_HMAC_KEY=replace-with-32-byte-random

# ───────────────────────────────────────────────────────────
# 12. Optional: Partner portal / dashboard
# ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
SAURON_CORE_INTERNAL_URL=http://localhost:3001
# The legacy proxy-token model is removed; dashboard access uses the signed session below.
#
# Dashboard operator auth + tenant isolation (REQUIRED in production — without
# these the /api proxy would be an anonymous god-mode gateway with a
# client-asserted tenant). In development they default to a dev secret + a
# `dev`/`dev` super operator so the local demo works.
#   - SESSION_SECRET signs the operator session cookie (HMAC-SHA256).
#   - OPERATORS is a JSON map: operator -> {password_scrypt, tenants[], super}.
#     Raw SHA-256 passwords are accepted only for local development.
#     Non-super operators may only act on their listed tenants; super ⇒ any tenant.
# SAURON_DASHBOARD_SESSION_SECRET=replace-with-32-byte-random
# SAURON_DASHBOARD_OPERATORS={"alice":{"password_scrypt":"<salt_b64>:<hash_b64>","tenants":["acme"],"super":false},"root":{"password_scrypt":"<salt_b64>:<hash_b64>","tenants":[],"super":true}}

# ───────────────────────────────────────────────────────────
# 13. Optional: real-agent stress harness (kya-redteam)
# ───────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# REAL_AGENT_STRESS_ITERATIONS=3
# REAL_AGENT_STRESS_CONCURRENCY=2
# REAL_AGENT_TAVILY_MAX_CALLS=3

# ───────────────────────────────────────────────────────────
# 14. /demo Real LLM call — provider API keys (optional)
# ───────────────────────────────────────────────────────────
# Setting any of these means the REAL.LLM.CALL card on /demo can
# use that provider WITHOUT pasting a key in the browser. The
# /api/live/demo/llm-providers endpoint reports which keys are
# present so the UI shows a "KEY FROM .ENV" badge and lets you
# leave the API key field blank.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# QWEN_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# TAVILY_API_KEY=tvly-...

# ═══════════════════════════════════════════════════════════
# 15. Remaining core knobs — the long tail
# ═══════════════════════════════════════════════════════════
# Everything the core reads that is not covered above. This section is not
# optional documentation: `core/tests/env_documented.rs` fails the build when a
# variable is read from `core/src` and named nowhere in this file, so the list
# cannot silently drift again. Add the variable here in the same commit that
# introduces it.
#
# Values shown are the CODE defaults. Where dev and production differ, both are
# given — those are the ones that decide whether a deployment is fail-closed.

# ── Fail-closed switches (production defaults ON; set 0 only deliberately) ──
# SAURON_REQUIRE_OWNER_MANDATE=1      # dev 0 / prod 1. Registration must carry the human
#                                     # owner's signature over the grant. With it off, the
#                                     # operator's word IS the authority — this is the flag
#                                     # the README's "operator cannot invent authority"
#                                     # claim depends on.
# SAURON_REQUIRE_EXTERNAL_CLIENT_KEYS=1 # dev 0 / prod 1. Refuse to generate a partner ring
#                                     # key server-side; partners must supply their own
#                                     # public key + key image and keep custody.
# SAURON_ALLOW_SERVER_DERIVED_POP=0   # Permit server-derived proof-of-possession keys.
#                                     # A downgrade: the server then knows a key it is
#                                     # supposed to be able only to verify. Legacy only.
# SAURON_ENABLE_DEV_ENDPOINTS=0       # Mounts /dev/* (user seeding, fixtures). Never in prod.
# SAURON_ENFORCE_STATS_FRESHNESS=1    # Reject STARK stats proofs whose period is stale.
# SAURON_REVOKE_LEGACY_DELEGATED_NONBANK=1 # Revoke pre-pivot delegated non-bank agents at boot.

# ── Identity / signing scope ──
# SAURON_CALL_AUDIENCE=sauron-core    # Value every call signature must claim in
#                                     # x-sauron-call-audience. Change it per deployment so a
#                                     # signature minted for one environment cannot be
#                                     # replayed against another.
# SAURON_AJWT_AUDIENCE=sauron-core    # Same idea for the A-JWT `aud` claim.
# SAURON_ADMIN_KEYS=key1,key2         # Additional full-access admin keys beyond
#                                     # SAURON_ADMIN_KEY (comma-separated; supports Vault
#                                     # ciphertexts when Vault Transit is enabled).
# SAURON_TENANT_ID=default            # Default tenant used by the bundled CLI client.
# SAURON_ENV / SAURON_RUNTIME_ENV     # Lower-precedence aliases for ENV. Prefer ENV.

# ── RFC 9449 DPoP compatibility (opt-in) ──
# SAURON_ACCEPT_DPOP=0                # Accept a `dpop` proof header in place of the
#                                     # x-sauron-call-sig set. Documented weakness: DPoP does
#                                     # not bind the body digest or the config digest.
# SAURON_ACCEPT_DPOP_IN_PROD=0        # Second, separate opt-in required in production.

# ── Rate limiting and outbound HTTP ──
# SAURON_GLOBAL_RATE_LIMIT_RPS=200    # Process-wide request ceiling, per client IP.
# SAURON_GLOBAL_RATE_LIMIT_BURST=400  # Token-bucket burst above the sustained rate.
# SAURON_RISK_EGRESS_CAPABILITY_PER_WINDOW  # Per-agent egress-capability issuance cap.
# SAURON_RISK_AGENT_VC_ISSUE_PER_WINDOW     # Per-agent VC issuance cap.
# SAURON_HTTP_TIMEOUT_MS=15000        # Outbound request timeout (clamped 500..120000).
# SAURON_HTTP_CONNECT_TIMEOUT_MS      # Outbound connect timeout.
# SAURON_DB_POOL_SIZE=16              # SQLite pool size (clamped 1..64). Exhaustion answers
#                                     # 503 with Retry-After, not 500.
# SAURON_DB_POOL_TIMEOUT_MS=30000     # How long a request waits for a free connection before
#                                     # it is shed (clamped 100..60000). 30s is r2d2's default
#                                     # and the wrong shape for a request path: a client that
#                                     # has queued half a minute has usually given up, and the
#                                     # queue behind it grew the whole time. Lower it (2000-5000)
#                                     # to shed early and let load drain.

# ── Audit sink ──
# SAURON_AUDIT_LOG_PATH=/var/log/sauronid/audit.jsonl  # Append the hash-chained audit
#                                     # stream to a file as well as the DB. Unset = DB only.

# ── Transparent (RISC Zero) proof verification ──
# SAURON_TRANSPARENT_IMAGE_IDS_JSON=/etc/sauronid/image-ids.json # Override the compiled-in
#                                     # guest image IDs. Only for verifying a guest you
#                                     # rebuilt yourself.
# SAURON_TRANSPARENT_VERIFY_CONCURRENCY=2      # Parallel verifications (clamped 1..16).
# SAURON_TRANSPARENT_VERIFY_TIMEOUT_SECS       # Per-proof verification timeout.
# SAURON_STATS_MAX_AGE_SECS=1209600   # Oldest accepted stats proof (14d; clamped 300..1y).
# SAURON_STATS_MAX_PERIOD_SECS        # Longest accepted aggregation period.

# ── Hardware attestation roots ──
# SAURON_TPM2_VENDOR_ROOTS_DIR=/etc/sauronid/tpm-roots  # PEM vendor roots for TPM2 EK chains.
# SAURON_NITRO_ROOT_PEM=/etc/sauronid/nitro-root.pem    # AWS Nitro attestation root.
# SAURON_NITRO_ALLOW_STUB=0           # Accept a stubbed Nitro document. TESTING ONLY —
#                                     # it makes the attestation claim meaningless.
# SAURON_ENCLAVE_PORT                 # Listen port for the nitro-enclave helper binary.

# ── Compliance overlay (only with SAURON_DISABLE_COMPLIANCE=0) ──
# SAURON_COMPLIANCE_JURISDICTION_MODE=observe  # off | observe | enforce. dev default off,
#                                     # prod default observe (decisions logged, not denied).
# SAURON_COMPLIANCE_JURISDICTION_ALLOWLIST=FR,DE,ES  # ISO country codes permitted in enforce.
# SAURON_COMPLIANCE_OVERLAY_VERSION   # Version stamped onto compliance decisions.

# ── Legacy / unaudited paths — off by default, and should stay off ──
# SAURON_ENABLE_LEGACY_OPRF=0         # Pre-OPAQUE OPRF flow.
# SAURON_ENABLE_LEGACY_OPRF_AUTH=0    # Authenticate users via that legacy flow.
# SAURON_ENABLE_LEGACY_TOKEN_MAC=0    # Accept the pre-v2 token MAC construction.
# SAURON_ENABLE_GROTH16=0             # Legacy circom/Groth16 verification path.
# SAURON_ENABLE_KYC_GROTH16=0         # Groth16 for the KYC credential circuit.
# SAURON_ENABLE_UNAUDITED_PAILLIER=0  # Custom Paillier implementation. Named "unaudited"
#                                     # because it is; do not enable it in production.
# SAURON_ENABLE_HE=0                  # Homomorphic aggregation surface.
# SAURON_ENABLE_VOLUNTARY_EGRESS_LOG=0 # Accept self-reported egress logs. Self-reporting is
#                                     # not enforcement — the in-path gateway is
#                                     # SAURON_EGRESS_GATEWAY.

# ── External issuer service (legacy ZKP issuance) ──
# SAURON_ISSUER_URLS=https://issuer-a.example,https://issuer-b.example
# SAURON_ISSUER_SHARED_SECRET=...     # HMAC secret shared with the issuer service.
# SAURON_ISSUER_CIRCUIT_FAILURE_THRESHOLD=5  # Failures before the breaker opens.
# SAURON_ISSUER_CIRCUIT_OPEN_SECS     # How long the breaker stays open.

# ── Solana ──
# SAURON_SOLANA_KEYPAIR_INLINE=[1,2,...]  # Keypair as an inline JSON array, for environments
#                                     # that inject secrets as env vars rather than files.
#                                     # Prefer SAURON_SOLANA_KEYPAIR_PATH.
