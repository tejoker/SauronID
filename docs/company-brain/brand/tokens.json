{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "brand": "SauronID",
  "version": "2.0",
  "updated": "2026-08",
  "principle": "Light-first product. Deep-navy proof moments.",
  "color": {
    "brand": {
      "midnight950": { "value": "#000D35", "role": "deep brand and proof surface" },
      "navy900": { "value": "#000F3B", "role": "dark component surface" },
      "navy800": { "value": "#071B51", "role": "dark elevated surface" },
      "signal600": { "value": "#0054F3", "role": "primary action" },
      "signal500": { "value": "#2384FB", "role": "secondary action and progress" },
      "sky300": { "value": "#78C6FB", "role": "highlight on dark surfaces" },
      "cloud50": { "value": "#F7FAFF", "role": "product canvas" },
      "white": { "value": "#FFFFFF", "role": "primary surface" }
    },
    "neutral": {
      "ink950": "#071229",
      "slate700": "#455570",
      "slate600": "#60708F",
      "slate400": "#8B98B3",
      "border200": "#D7E1F1",
      "border100": "#E8EEF8"
    },
    "state": {
      "allowed": { "solid": "#0C9B8E", "soft": "#EAF8F5", "label": "Allowed" },
      "review": { "solid": "#D69020", "soft": "#FFF7E8", "label": "Needs approval" },
      "stopped": { "solid": "#D94C64", "soft": "#FFF0F3", "label": "Stopped" },
      "running": { "solid": "#6C63E8", "soft": "#F1EFFF", "label": "Running" }
    },
    "role": {
      "canvas": "{color.brand.cloud50}",
      "surface": "{color.brand.white}",
      "surfaceSoft": "#EEF4FF",
      "surfaceDark": "{color.brand.midnight950}",
      "surfaceDarkElevated": "{color.brand.navy800}",
      "textPrimary": "{color.neutral.ink950}",
      "textSecondary": "{color.neutral.slate600}",
      "textTertiary": "{color.neutral.slate400}",
      "textOnDark": "{color.brand.white}",
      "textOnDarkMuted": "#BFD8FF",
      "actionPrimary": "{color.brand.signal600}",
      "actionPrimaryHover": "#0047CF",
      "actionSecondary": "{color.brand.signal500}",
      "divider": "{color.neutral.border200}",
      "focusRing": "rgba(35,132,251,0.42)"
    }
  },
  "typography": {
    "display": "Inter Tight",
    "sans": "Inter",
    "mono": "IBM Plex Mono",
    "fallbackSans": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "scale": {
      "displayXL": { "size": "clamp(56px, 7vw, 88px)", "lineHeight": 0.98, "weight": 700, "tracking": "-0.04em" },
      "display": { "size": "clamp(44px, 5vw, 72px)", "lineHeight": 1.04, "weight": 700, "tracking": "-0.035em" },
      "h1": { "size": "clamp(36px, 4vw, 56px)", "lineHeight": 1.08, "weight": 700, "tracking": "-0.025em" },
      "h2": { "size": "clamp(28px, 3vw, 42px)", "lineHeight": 1.18, "weight": 650, "tracking": "-0.02em" },
      "h3": { "size": "24px", "lineHeight": 1.33, "weight": 600 },
      "bodyLarge": { "size": "20px", "lineHeight": 1.5, "weight": 400 },
      "body": { "size": "16px", "lineHeight": 1.625, "weight": 400 },
      "small": { "size": "14px", "lineHeight": 1.5, "weight": 450 },
      "label": { "size": "12px", "lineHeight": 1.33, "weight": 600 },
      "mono": { "size": "13px", "lineHeight": 1.54, "weight": 500 }
    }
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
  "radius": {
    "small": 10,
    "medium": 16,
    "large": 24,
    "window": 28,
    "pill": 999
  },
  "motion": {
    "durationMs": {
      "instant": 80,
      "micro": 160,
      "component": 280,
      "step": 420,
      "narrative": 620
    },
    "easing": {
      "out": "cubic-bezier(.22, 1, .36, 1)",
      "standard": "cubic-bezier(.4, 0, .2, 1)"
    },
    "reducedMotion": "replace non-essential motion with instant state changes"
  },
  "shadow": {
    "small": "0 8px 24px rgba(0, 15, 59, .08)",
    "medium": "0 18px 48px rgba(0, 15, 59, .12)",
    "large": "0 28px 90px rgba(0, 15, 59, .18)",
    "focus": "0 0 0 4px rgba(35, 132, 251, .42)"
  },
  "gradient": {
    "orbit": "linear-gradient(135deg, #000D35 0%, #133F9E 48%, #2384FB 100%)",
    "signal": "linear-gradient(110deg, #0054F3 0%, #78C6FB 100%)",
    "canvasGlow": "radial-gradient(circle at 75% 20%, rgba(35,132,251,.16), transparent 42%)"
  },
  "componentDefaults": {
    "controlHeight": { "small": 36, "medium": 48, "large": 52 },
    "contentMaxPx": 1200,
    "gutterPx": { "mobile": 16, "desktop": 24 },
    "boundaryRailPx": 4,
    "button": { "radius": 999, "fontWeight": 600 },
    "card": { "radius": 16, "border": "{color.neutral.border200}", "shadow": "{shadow.small}" }
  }
}
