# SauronID core env — systemd EnvironmentFile (no-Docker path).
# Copy to core.env ON THE VM and fill in. Plain KEY=VAL only (no `export`, no
# quotes, no ${interpolation} — systemd reads it literally). Never commit.
#
# Generate the secrets (>= 32 bytes each):
#   for v in SAURON_ADMIN_KEY SAURON_TOKEN_SECRET SAURON_JWT_SECRET SAURON_OPRF_SEED SAURON_ISSUER_SHARED_SECRET; do
#     echo "$v=$(openssl rand -hex 32)"; done

# DEMO posture (verified on real hardware): ENV=development enables the
# /dev/register_user onboarding the demo uses, while per-call-signature
# enforcement below stays ON so the attack demo is real. The agent-governance
# (binding, signatures, anchoring) is exercised for real; only the human
# onboarding uses a dev convenience. For true production hardening see
# docs/production-readiness.md.
ENV=development
SAURON_ENABLE_DEV_ENDPOINTS=1
PORT=3001
DATABASE_PATH=/opt/sauronid/data/sauron.db

# Root secrets
SAURON_ADMIN_KEY=REPLACE
SAURON_TOKEN_SECRET=REPLACE
SAURON_JWT_SECRET=REPLACE
SAURON_OPRF_SEED=REPLACE
SAURON_ISSUER_SHARED_SECRET=REPLACE

# Production gates (keep on)
SAURON_REQUIRE_CALL_SIG=1
SAURON_REQUIRE_AGENT_TYPE=1
SAURON_POLICY_ENFORCEMENT_MODE=enforce
SAURON_ACCEPT_SINGLE_NODE_SQLITE=1

# CORS = the dashboard origin (sslip.io; dots -> dashes)
SAURON_ALLOWED_ORIGINS=https://dash.REPLACE-VM-IP.sslip.io

# Trim unused subsystems for the agent-binding demo
SAURON_DISABLE_ZKP=1
SAURON_DISABLE_COMPLIANCE=1

# Anchoring: Bitcoin OTS free + on by default; Solana off (faucet-gated).
SAURON_BITCOIN_ANCHOR_PROVIDER=opentimestamps
SAURON_SOLANA_ENABLED=0
# To enable Solana: set =1, run setup-solana.sh, and uncomment:
# SAURON_SOLANA_RPC_URL=https://api.devnet.solana.com
# SAURON_SOLANA_NETWORK=devnet
# SAURON_SOLANA_KEYPAIR_PATH=/opt/sauronid/solana-keypair.json

# Dashboard (only used if ENABLE_DASHBOARD=1 in site.env)
SAURONID_TENANTS=default
