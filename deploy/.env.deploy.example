# ──────────────────────────────────────────────────────────────────────────
# SauronID demo deploy — copy to `.env` and fill in. NEVER commit the real .env.
#
#   cp .env.deploy.example .env   &&   edit .env
#
# Generate the four root secrets (each must be >= 32 bytes):
#   for v in SAURON_ADMIN_KEY SAURON_TOKEN_SECRET SAURON_JWT_SECRET SAURON_OPRF_SEED; do
#     echo "$v=$(openssl rand -hex 32)"; done
# ──────────────────────────────────────────────────────────────────────────

# ── DNS / TLS (Caddy) ──────────────────────────────────────────────────────
# Both must be A-records pointing at this VM. Ports 80 + 443 open.
CORE_DOMAIN=core.your-demo.example
DASH_DOMAIN=dash.your-demo.example
ACME_EMAIL=you@example.com

# Dashboard basic-auth gate (the dashboard has no built-in user auth yet).
# Generate the hash:
#   docker run --rm caddy caddy hash-password --plaintext 'choose-a-strong-password'
DASH_USER=demo
DASH_BASICAUTH_HASH=REPLACE_WITH_caddy_hash-password_OUTPUT

# ── Core root secrets (>= 32 bytes each) ───────────────────────────────────
SAURON_ADMIN_KEY=REPLACE_openssl_rand_hex_32
SAURON_TOKEN_SECRET=REPLACE_openssl_rand_hex_32
SAURON_JWT_SECRET=REPLACE_openssl_rand_hex_32
SAURON_OPRF_SEED=REPLACE_openssl_rand_hex_32

# Issuer shared secret only matters if you re-enable the ZKP issuer; the demo
# disables it below, but the prod compose validates it is non-empty.
SAURON_ISSUER_SHARED_SECRET=REPLACE_openssl_rand_hex_32

# ── Production gates (MANDATORY — keep these on) ───────────────────────────
SAURON_REQUIRE_CALL_SIG=1
SAURON_REQUIRE_AGENT_TYPE=1
SAURON_POLICY_ENFORCEMENT_MODE=enforce
SAURON_ACCEPT_SINGLE_NODE_SQLITE=1

# CORS: the browser only talks to the dashboard origin.
SAURON_ALLOWED_ORIGINS=https://dash.your-demo.example

# ── Trim unused subsystems for the agent-binding demo ──────────────────────
SAURON_DISABLE_ZKP=1
SAURON_DISABLE_COMPLIANCE=1

# ── Anchoring ──────────────────────────────────────────────────────────────
# Bitcoin via OpenTimestamps — free, no key custody.
SAURON_BITCOIN_ANCHOR_PROVIDER=opentimestamps
# Solana memo — free on devnet. Run ./setup-solana.sh first to create
# ./secrets/solana-devnet.json (mounted into the backend by the compose file).
SAURON_SOLANA_ENABLED=1
SAURON_SOLANA_RPC_URL=https://api.devnet.solana.com
SAURON_SOLANA_NETWORK=devnet
# (SAURON_SOLANA_KEYPAIR_PATH is set by the compose file to the mount path.)

# ── Dashboard ──────────────────────────────────────────────────────────────
SAURONID_TENANTS=default

# ── Optional ───────────────────────────────────────────────────────────────
# SAURONID_IMAGE_TAG=latest
