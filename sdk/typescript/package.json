{
  "name": "@sauronid/agentic",
  "version": "2.0.0",
  "description": "SauronID agent identity SDK \u2014 register AI agents, sign every call (Ed25519 call-sig v2), enforce policy at the tool boundary, A-JWT intent tokens and delegation chains",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejoker/SauronID.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "agent",
    "ai-agent",
    "identity",
    "ed25519",
    "proof-of-possession",
    "policy-enforcement",
    "a-jwt",
    "sauronid"
  ],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "test": "npm run build && node dist/test/e2e.test.js && node dist/test/signed-agent.test.js && node dist/test/ring.test.js",
    "test:integration": "npm run build && node dist/test/integration-shim.test.js",
    "test:enforcement": "npm run build && node dist/test/enforcement.test.js",
    "test:stats": "npm run build && node dist/test/local-aggregate.test.js && node dist/test/transparent-stats.test.js"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "@noble/ed25519": "^2.0.0",
    "@noble/hashes": "^1.7.1",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.4.0"
  }
}
